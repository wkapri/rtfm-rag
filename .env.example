DATABASE_URL=postgresql://ragapp:ragapp@localhost:5432/ragapp

# Which chat LLM backend to use: ollama (default, fully local), openai, or anthropic.
# Embeddings always use Ollama regardless of this setting.
LLM_PROVIDER=ollama

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=30m
OLLAMA_CHAT_NUM_CTX=2048
CHAT_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text

# Only needed if LLM_PROVIDER=openai. base_url can point at any OpenAI-compatible
# endpoint, not just OpenAI itself.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Only needed if LLM_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=
# ANTHROPIC_CHAT_MODEL=claude-haiku-4-5-20251001

CHUNK_SIZE=700
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=5
